<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:BogChatDesktopClient.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BogChatDesktopClient.Views.LoginPageView"
             x:DataType="viewModels:LoginPageViewModel">
    <Panel VerticalAlignment="Stretch"
           HorizontalAlignment="Stretch"
           Background="#1f1f1f">

        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                MinWidth="200"
                MinHeight="200"
                CornerRadius="6"
                Padding="12"
                BorderBrush="#115511"
                BorderThickness="4"
                Background="#227722">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6">
                <Label Content="Username:" />
                <TextBox Name="Username" Padding="6"
                         MinWidth="200"
                         Text="{Binding Username}" />
                <Button Command="{Binding LoginCommand}"
                        Margin="3"
                        Padding="6"
                        Background="#1f1f1f"
                        Foreground="#EEEEEE"
                        Content="Login" />

                <TextBlock Name="ErrorMessage" IsVisible="False" Text="{Binding ErrorMessage}" />
            </StackPanel>
        </Border>

    </Panel>
</UserControl>