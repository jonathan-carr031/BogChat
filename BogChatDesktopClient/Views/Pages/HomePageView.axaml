<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="2560" d:DesignHeight="1440"
             xmlns:ic="using:FluentIcons.Avalonia"
             xmlns:pages="clr-namespace:BogChatDesktopClient.ViewModels.Pages"
             x:Class="BogChatDesktopClient.Views.Pages.HomePageView"
             x:DataType="pages:HomePageViewModel">

    <Design.DataContext>
        <pages:HomePageViewModel />
    </Design.DataContext>

    <!-- MainPage -->
    <Grid Name="MainGrid" ColumnDefinitions="Auto, *, Auto" Background="{DynamicResource PrimaryBackground}">
        <!-- Maximized StreamPane Overlay-->
        <Panel Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" ZIndex="1"
               IsVisible="{Binding HasMaximizedParticipant}"
               Background="#1f2f1f">
            <Panel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <Image Stretch="Fill"
                       Source="{Binding MaximizedParticipant?.VideoStream}" />

                <Border CornerRadius="6" Background="#000000" Margin="20" Padding="12 6" HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding MaximizedParticipant?.Username}"
                               Foreground="#dedede" />
                </Border>
                <Button Click="ResetStreamPaneSize" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"
                        Background="#DD000000">
                    <ic:FluentIcon Icon="ArrowMinimize" Foreground="#FFFFFF" />
                </Button>
            </Panel>
        </Panel>

        <!-- UserPanel -->
        <Border Grid.Column="0" Name="LeftPanel"
                CornerRadius="0 6 6 0"
                Background="#31402e">
            <Grid RowDefinitions="*, Auto">
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal">
                    <StackPanel Name="UserPanel"
                                Margin="12">
                        <ItemsRepeater ItemsSource="{Binding Channels}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Button Name="JoinRoomButton"
                                                Margin="0 6"
                                                Click="JoinRoom"
                                                Command="{Binding $parent[ItemsRepeater].((pages:HomePageViewModel)DataContext)?.JoinRoom}"
                                                CommandParameter="{Binding }">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" />
                                            </StackPanel>
                                        </Button>
                                        <ItemsRepeater ItemsSource="{Binding Participants}">
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,10,0,0"
                                                            CornerRadius="5"
                                                            BorderBrush="#006600" BorderThickness="1"
                                                            Background="#006600"
                                                            Padding="5">
                                                        <StackPanel Orientation="Vertical">
                                                            <TextBlock Text="{Binding}"></TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <ItemsRepeater ItemsSource="{Binding RoomPeople}">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,10,0,0"
                                            CornerRadius="5"
                                            BorderBrush="#006600" BorderThickness="1"
                                            Background="#006600"
                                            Padding="5">
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock Text="{Binding}"></TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <TextBlock Name="VersionNumber" Text="No Version Set" TextWrapping="Wrap" MaxWidth="100"></TextBlock>
                    </StackPanel>
                </StackPanel>

                <Panel Grid.Row="1">
                    <StackPanel Orientation="Horizontal" Margin="6" Spacing="3" VerticalAlignment="Center">
                        <ic:FluentIcon Icon="Person" IconVariant="Regular" IconSize="Size32" />
                        <TextBlock VerticalAlignment="Center" Name="Username" Text="{Binding Username}" />
                        <Border CornerRadius="6" Background="#33000000">
                            <Button Click="Logout_Event">
                                <ic:FluentIcon Icon="ArrowExit" IconVariant="Regular" IconSize="Size12"></ic:FluentIcon>
                            </Button>
                        </Border>
                    </StackPanel>

                </Panel>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Column="1" Name="ContentPanel"
              RowDefinitions="Auto, Auto">
            <!-- Video Panel -->
            <Grid Grid.Row="0"
                  Name="VideoPanel"
                  IsVisible="False"
                  RowDefinitions="*, Auto">
                <ScrollViewer Grid.Row="0">
                    <ItemsRepeater ItemsSource="{Binding RoomParticipants}">
                        <ItemsRepeater.Layout>
                            <WrapLayout Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="8"
                                    ClipToBounds="True"
                                    BorderBrush="{Binding BorderColor}"
                                    BorderThickness="4"
                                    Width="600"
                                    Height="338"
                                    Background="#131313"
                                    PointerPressed="Enlarge">
                                    <Border CornerRadius="12"
                                            ClipToBounds="True">
                                        <Panel>
                                            <Image Name="DisplayImage"
                                                   Stretch="Fill"
                                                   Source="{Binding VideoStream}" />

                                            <TextBlock Text="{Binding Username}" Margin="20" Foreground="#dedede"></TextBlock>
                                        </Panel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Name="MuteButton"
                            Click="Mute"
                            Command="{Binding MuteVoice}">
                        <ic:FluentIcon Icon="MicOff" />
                    </Button>
                    <Button Name="UnmuteButton"
                            Click="UnMute"
                            Command="{Binding UnmuteVoice}"
                            IsVisible="False">
                        <ic:FluentIcon Icon="Mic" />
                    </Button>
                    <Button Name="StartStreamButton"
                            Command="{Binding RecordApplication}"
                            IsVisible="{Binding !IsStreaming}">
                        <ic:FluentIcon Icon="ShareScreenStart" />
                    </Button>
                    <Button Name="StopStreamButton"
                            Command="{Binding StopStreaming}"
                            IsVisible="{Binding IsStreaming}">
                        <ic:FluentIcon Icon="ShareScreenStop" />
                    </Button>
                    <Border CornerRadius="12"
                            ClipToBounds="True">
                        <Button Name="LeaveCallButton"
                                Background="#EE9999"
                                Click="LeaveRoom"
                                Command="{Binding LeaveRoom}"
                                IsVisible="True">
                            <ic:FluentIcon Icon="CallEnd" />
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- Text Panel -->
            <Grid Grid.Row="1"
                  Name="TextPanel"
                  IsVisible="False"
                  RowDefinitions="*, Auto">
                <ScrollViewer Grid.Row="0">
                    <ItemsRepeater ItemsSource="{Binding ChannelMessages}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Vertical" Spacing="10" />
                        </ItemsRepeater.Layout>

                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Background="#1f1f1f">
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Grid.Column="0"
                                 HorizontalAlignment="Stretch"
                                 Background="Transparent"
                                 Padding="24"
                                 PlaceholderText="Message" />
                        <Button Grid.Column="1" Padding="24"
                                Background="Transparent">
                            <ic:FluentIcon Icon="Send" IconVariant="Regular" IconSize="Size32" />
                        </Button>
                    </Grid>
                </Border>

                <Panel Grid.Row="0" Grid.RowSpan="2">
                    <ContentControl Content="{Binding CurrentTextChannel}"></ContentControl>
                </Panel>
            </Grid>
        </Grid>

        <StackPanel Grid.Column="2" Name="RightPanel">
            <ItemsRepeater ItemsSource="{Binding StreamableItems}">
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,10,0,0"
                                CornerRadius="5"
                                BorderBrush="Black" BorderThickness="1"
                                Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Command="{Binding $parent[ItemsRepeater].((pages:HomePageViewModel)DataContext)?.StreamableItemClickEvent}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding WindowTitle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </Grid>
</UserControl>