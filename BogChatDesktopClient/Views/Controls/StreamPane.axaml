<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:BogChatDesktopClient.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BogChatDesktopClient.Controls.StreamPane"
             x:DataType="viewModels:StreamPaneViewModel">
    <Border CornerRadius="8"
            ClipToBounds="True"
            BorderThickness="4"
            Background="#131313">
        <Border CornerRadius="12"
                ClipToBounds="True">
            <Panel>
                <Image Name="DisplayImage"
                       Stretch="Fill"
                       Source="" />

                <TextBlock Text="{Binding RoomParticipant.Username}" Margin="20" Foreground="#dedede" />
            </Panel>
        </Border>
    </Border>
</UserControl>