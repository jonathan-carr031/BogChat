<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:BogChatDesktopClient.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="BogChatDesktopClient.MainWindow"
        x:DataType="viewModels:MainWindowViewModel"
        Title="BogChatDesktopClient"
        Background="#232323">
    <DockPanel Background="BlueViolet">
        <TextBlock Name="HeaderText" Text="{Binding TestOutput}"></TextBlock>

        <Panel Name="ImagePanel">
            <Image Name="VideoOutput"
                   Width="600"
                   Height="400"
                   Stretch="Fill"
                   Source="{Binding VideoFrame}">
            </Image>
        </Panel>

        <Button Command="{Binding JoinRoom}">Join The Bog</Button>
        <Button Command="{Binding LeaveRoom}">Leave The Bog</Button>
        <!-- -->
        <!-- -->
        <Button Click="Mute">Mute</Button>
        <Button Click="UnMute">UnMute</Button>
        <!-- <Button Click="RecordMic">RecordMic</Button> -->
        <!-- <Button Click="StopRecording">StopRecording</Button> -->

        <!-- <Panel DockPanel.Dock="Right"> -->
